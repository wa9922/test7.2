options:
  parameters:
    author: AGC System
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: AGC System Comparison (Low-Power vs High-Performance vs Adaptive)
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: .:.
    id: agc_comparison
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: AGC System Comparison
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '20000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: enabled

- name: snr_db
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: SNR (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '30'
    value: '10'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 12]
    rotation: 0
    state: true

- name: traffic_type
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: ''
    label: Traffic Type
    label0: Low Power Signal
    label1: High Performance Signal
    label2: ''
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '2'
    option0: lowpowersignal
    option1: highperformancesignal
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0, 1, 2]'
    orient: Qt.QVBoxLayout
    type: string
    value: lowpowersignal
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 12]
    rotation: 0
    state: true

# ==================== Packet Source ====================
- name: packet_source
  id: epy_block
  parameters:
    _source_code: "import sys\nsys.path.insert(0, '/home/user/test7.2/gnu/python')\n\
      from agc_packet_source import agc_packet_source\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    packets_per_burst: '20'
    repeat: 'True'
    snr_db: snr_db
    traffic_type: traffic_type
  states:
    _io_cache: ('AGC Packet Source', 'agc_packet_source', [('traffic_type', 'lowpowersignal'),
      ('snr_db', '10.0'), ('packets_per_burst', '10'), ('repeat', 'True')], [], [('0',
      'complex', 1), ('packet_info', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 180]
    rotation: 0
    state: true

# ==================== AGC System Blocks ====================
# Low-Power AGC
- name: agc_low_power
  id: epy_block
  parameters:
    _source_code: "import sys\nsys.path.insert(0, '/home/user/test7.2/gnu/python')\n\
      from agc_system_block import agc_system_block\n"
    affinity: ''
    alias: ''
    agc_mode: low_power
    comment: ''
    enable_gain_feedback: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('AGC System', 'agc_system_block', [('agc_mode', 'adaptive'), ('enable_gain_feedback',
      'True')], [('0', 'complex', 1), ('traffic_info', 'message', 1)], [('0', 'complex',
      1), ('agc_stats', 'message', 1)], '', [])
    bus_sink: false
