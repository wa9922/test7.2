# ==================== Connections ====================
connections:
- [packet_source, '0', agc_low_power, '0']
- [packet_source, '0', agc_high_perf, '0']
- [packet_source, '0', agc_adaptive, '0']
- [packet_source, packet_info, agc_low_power, traffic_info]
- [packet_source, packet_info, agc_high_perf, traffic_info]
- [packet_source, packet_info, agc_adaptive, traffic_info]
- [agc_low_power, '0', ber_calc_lp, '0']
- [agc_low_power, '0', power_meter_lp, '0']
- [agc_low_power, '0', qtgui_time_sink_lp, '0']
- [agc_high_perf, '0', ber_calc_hp, '0']
- [agc_high_perf, '0', power_meter_hp, '0']
- [agc_adaptive, '0', ber_calc_adaptive, '0']
- [agc_adaptive, '0', power_meter_adaptive, '0']
- [ber_calc_lp, '0', qtgui_number_sink_ber, '0']
- [ber_calc_hp, '0', qtgui_number_sink_ber, '1']
- [ber_calc_adaptive, '0', qtgui_number_sink_ber, '2']

